#!/bin/sh
# ctally: CTally from the shell and from tmux.
#
#   ctally status [--tmux]       counts of live sessions by state, most urgent first:
#                                "!1 ▶2 ✓5 ·1" (waiting, working, done, idle); --tmux adds
#                                status-line colours
#   ctally list                  one line per live session: state, tmux pane, project, id
#   ctally jump [pane client socket]
#                                switch a tmux client to the session that needs you:
#                                waiting first, then finished, longest-waiting first.
#                                Run it again to move on to the next one. A key binding
#                                passes '#{pane_id}' '#{client_name}' '#{socket_path}'.
#
# Reads ~/.claude/ctally.d, which CTally's Claude Code hooks keep up to date. A session
# started inside tmux carries TMUX (the server's socket) and TMUX_PANE (its pane) in its
# environment; that's how a session is found in tmux.

dir="$HOME/.claude/ctally.d"

# Each live session as "rank mtime state pid id project": rank 0 waiting, 1 done,
# 2 working, 3 idle; the project comes last because it may contain spaces. Sessions whose
# claude process is gone are skipped.
sessions() {
  for file in "$dir"/*; do
    [ -f "$file" ] || continue
    read -r state pid project < "$file" || continue
    case "$pid" in '' | *[!0-9]*) continue ;; esac
    kill -0 "$pid" 2>/dev/null || continue
    case "$state" in
      waiting) rank=0 ;; done) rank=1 ;; working) rank=2 ;; *) rank=3; state=idle ;;
    esac
    printf '%s %s %s %s %s %s\n' "$rank" "$(stat -f %m "$file")" "$state" "$pid" "${file##*/}" "${project:-?}"
  done | sort -n -k1,1 -k2,2
}

# "<socket> <pane id>" for a process started inside tmux, or nothing.
tmux_of() {
  ps eww -o command= -p "$1" 2>/dev/null | tr ' ' '\n' | awk -F= '
    $1 == "TMUX" { split($2, t, ","); socket = t[1] }
    $1 == "TMUX_PANE" { pane = $2 }
    END { if (socket != "" && pane != "") print socket, pane }'
}

status() {
  sessions | awk -v tmux="$1" '
    { count[$3]++ }
    END {
      split("waiting working done idle", order, " ")
      glyph["waiting"] = "!"; glyph["working"] = "▶"; glyph["done"] = "✓"; glyph["idle"] = "·"
      colour["waiting"] = "#ffb329"; colour["working"] = "#4accf2"
      colour["done"] = "#45e087"; colour["idle"] = "#99a6bd"
      out = ""
      for (i = 1; i <= 4; i++) {
        s = order[i]
        if (!count[s]) continue
        item = glyph[s] count[s]
        if (tmux == "--tmux") item = "#[fg=" colour[s] "]" item
        out = out (out == "" ? "" : " ") item
      }
      if (tmux == "--tmux" && out != "") out = out "#[default]"
      print out
    }'
}

list() {
  sessions | while read -r rank mtime state pid id project; do
    where=$(tmux_of "$pid")
    location="-"
    if [ -n "$where" ]; then
      location=$(tmux -S "${where% *}" display-message -p -t "${where#* }" \
        '#{session_name}:#{window_index}.#{pane_index}' 2>/dev/null || echo "-")
    fi
    printf '%-8s %-16s %-24s %s\n' "$state" "$location" "$project" "$id"
  done
}

jump() {
  current="${1:-${TMUX_PANE:-}}"
  client="${2:-}"
  here="${3:-${TMUX%%,*}}"
  # Sessions that need me, in tmux, in order: "<socket> <pane> <state> <project>".
  queue=$(sessions | while read -r rank mtime state pid id project; do
    [ "$rank" -le 1 ] || continue
    where=$(tmux_of "$pid")
    [ -n "$where" ] && printf '%s %s %s\n' "$where" "$state" "$project"
  done)

  say() {
    if [ -n "$client" ] && [ -n "$here" ]; then tmux -S "$here" display-message -c "$client" "$1" 2>/dev/null
    else echo "$1"; fi
  }
  if [ -z "$queue" ]; then
    say "CTally: nothing needs you"
    return 0
  fi

  # The one after the pane I'm on, so pressing again moves along the queue.
  target=$(printf '%s\n' "$queue" | awk -v current="$current" '
    { line[NR] = $0; if ($2 == current) at = NR }
    END { print line[at && at < NR ? at + 1 : 1] }')
  set -- $target
  socket=$1 pane=$2 state=$3
  shift 3
  project="$*"

  if [ -z "$here" ]; then
    echo "ctally jump: run it inside tmux (or bind it to a key); next up is $project ($state)" >&2
    return 1
  fi
  if [ "$socket" != "$here" ]; then
    say "CTally: $project is on another tmux server"
    return 1
  fi
  if [ -n "$client" ]; then
    tmux -S "$socket" switch-client -c "$client" -t "$pane" 2>/dev/null
  else
    tmux -S "$socket" switch-client -t "$pane" 2>/dev/null
  fi || { say "CTally: couldn't switch to $project"; return 1; }
  say "CTally: $project · $state"
}

case "${1:-}" in
  status) status "${2:-}" ;;
  list) list ;;
  jump) shift; jump "$@" ;;
  *) sed -n '2,/^$/s/^# \{0,1\}//p' "$0"; exit 2 ;;
esac
